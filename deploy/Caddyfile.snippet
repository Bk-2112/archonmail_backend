# ==============================================================================
# Team Archon Mail - Caddyfile Configuration Snippet
# Preserve all existing routes, CMSClipper PM2 app, and domains!
# ==============================================================================

# 1. Team Archon Mail Backend API (ASP.NET Core on port 8787)
api.teamarchon.in {
    # Automatic HTTPS via Caddy Let's Encrypt
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Reverse proxy to Team Archon Mail ASP.NET Core API
    reverse_proxy 127.0.0.1:8787 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# NOTE: Keep your existing CMSClipper block untouched!
# For example, if CMSClipper is running on its own domain or port,
# leave that block completely as-is:
#
# your-clipper-domain.com {
#     reverse_proxy 127.0.0.1:<clipper-port>
# }
