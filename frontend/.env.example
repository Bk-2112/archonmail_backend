# ==============================================================================
# Team Archon Mail - Frontend Environment Variables
# Copy to .env for local development or configure in Vercel Project Settings
# ==============================================================================

# Backend API Endpoint
# Production: https://api.teamarchon.in/api
# Local Dev: http://localhost:8787/api
VITE_API_BASE_URL=https://api.teamarchon.in/api

# Discord OAuth2 Client ID (From Discord Developer Portal > Applications)
VITE_DISCORD_CLIENT_ID=your_discord_client_id

# Discord OAuth2 Redirect URI (Must match the redirect URI registered in Discord Dev Portal)
# Production: https://mail.teamarchon.in/auth/callback
# Local Dev: http://localhost:5173/auth/callback
VITE_DISCORD_REDIRECT_URI=https://mail.teamarchon.in/auth/callback
