# ==============================================================================
# Team Archon Mail - Environment Variables
# ==============================================================================

# --- Supabase Configuration ---
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous/Public Key (used by React Vite frontend)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (from Supabase Dashboard > Settings > API > JWT Settings > JWT Secret)
# Used by ASP.NET Core backend to verify user JWT signatures
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-chars

# Supabase PostgreSQL Connection String (Session or Transaction pooler, or Direct)
# e.g., postgresql://postgres.xyz:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DB_CONNECTION_STRING=Host=aws-0-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project;Password=your-db-password;SslMode=Require;

# --- Backend Encryption ---
# 32-byte secret key for AES-256 server-side encryption of mailbox credentials
AES_KEY=your-super-secret-32-byte-aes-key__

# --- Backend Runtime ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8787

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_BASE_URL=https://api.teamarchon.in/api
