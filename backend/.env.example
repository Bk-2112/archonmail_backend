# ==============================================================================
# Team Archon Mail - Backend Environment Variables
# Location on VPS: /etc/teamarchon-api/teamarchon-api.env
# ==============================================================================

# ASP.NET Core Runtime
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:8787

# Supabase PostgreSQL Connection String (Transaction or Session pooler from Supabase Project Settings > Database)
DB_CONNECTION_STRING=Host=aws-0-us-east-1.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.your-project;Password=your_db_password;SslMode=Require;

# Discord OAuth2 Application Credentials (From Discord Developer Portal)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://mail.teamarchon.in/auth/callback

# Discord Server & Role Gate Enforcement
# DISCORD_GUILD_ID: Official Team Archon Discord Server ID
# DISCORD_REQUIRED_ROLE_ID: Discord Role ID required to access webmail
DISCORD_GUILD_ID=your_teamarchon_discord_guild_id
DISCORD_REQUIRED_ROLE_ID=your_required_role_id

# Categorized Discord Webhook Logging (URLs from Discord Channel Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_AUTH=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_MAIL=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_ERROR=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_SYSTEM=https://discord.com/api/webhooks/.../...

# Security & Encryption Keys
# Minimum 32-character secret key for signing session JWT tokens
JWT_SECRET=team_archon_super_secret_jwt_key_minimum_32_characters!
# Exactly 32-character secret key for AES-256 mailbox password encryption
AES_KEY=team_archon_aes_key_32_char_len!

# Stalwart Mail Server Loopback Endpoints
STALWART_IMAP_HOST=127.0.0.1
STALWART_IMAP_PORT=993
STALWART_SMTP_HOST=127.0.0.1
STALWART_SMTP_PORT=465
